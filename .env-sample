# Copy to services/api/.env for local runs without Docker. Every key can also be set as an environment variable.
APP_ENV=development
DATABASE_URL=sqlite:///./docflow.db
# Leave REDIS_URL empty to process jobs inside the API process.
REDIS_URL=
JWT_SECRET=local-development-signing-key-not-for-production
JWT_MINUTES=480
INTERNAL_KEY=local-internal-key
CORS_ORIGINS=http://localhost:3006
WEBHOOK_URL=
WEBHOOK_SECRET=
MAX_ATTEMPTS=3
MAX_UPLOAD_MB=5
# Optional first account.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
